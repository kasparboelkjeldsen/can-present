{
  "name": "can-present",
  "version": "0.1.0",
  "description": "Talks on an infinite canvas, for Vue 3: every scene is a card, and the camera flies and zooms between them.",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "vue",
    "presentation",
    "slides",
    "deck",
    "infinite-canvas",
    "talk"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kasparboelkjeldsen/can-present.git"
  },
  "homepage": "https://kasparboelkjeldsen.github.io/can-present/",
  "bugs": "https://github.com/kasparboelkjeldsen/can-present/issues",
  "main": "./lib/can-present.js",
  "module": "./lib/can-present.js",
  "exports": {
    ".": "./lib/can-present.js",
    "./style.css": "./lib/can-present.css",
    "./package.json": "./package.json"
  },
  "files": [
    "lib"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "canPresent": {
    "deck": "shovelling-umbraco"
  },
  "scripts": {
    "dev": "vite",
    "dev:lan": "vite --host",
    "build": "vite build",
    "preview": "vite preview",
    "deck": "node scripts/deck.mjs",
    "check": "node scripts/deck.mjs check",
    "compile": "node scripts/deck.mjs compile",
    "pack-deck": "node scripts/deck.mjs pack",
    "new-deck": "node scripts/new-deck.mjs",
    "import-pptx": "node scripts/import-pptx.mjs",
    "build:lib": "vite build --config vite.lib.config.js",
    "embed": "npm run build:lib && node scripts/deck.mjs pack example --out examples/embed/public/example.canpresent && vite --config examples/embed/vite.config.js",
    "prepack": "npm run build:lib"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/libre-caslon-text": "^5.3.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "fast-xml-parser": "^5.11.2",
    "jszip": "^3.10.2",
    "playwright-core": "1.64.1",
    "pptx2html": "https://codeload.github.com/g21589/PPTX2HTML/tar.gz/c8a96ebef4516e9d483c0bc54c61a3245c15aeb4",
    "qrcode-generator": "1.4.4",
    "sharp": "^0.35.5",
    "vite": "^8.3.4",
    "vue": "^3.5.44"
  }
}
